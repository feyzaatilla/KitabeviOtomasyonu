@model KitabeviApp.Models.Kitap

@{
    ViewData["Title"] = "Yeni Kitap Ekle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4>📖 Yeni Kitap Ekle</h4>
                </div>
                <div class="card-body">
                    <form method="post" action="/Kitap/Ekle" enctype="multipart/form-data">

                        <div class="mb-3">
                            <label class="form-label">Kitap Adı</label>
                            <input type="text" name="Adi" class="form-control"
                                   placeholder="Kitabın adını girin" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Yazar</label>
                            <input type="text" name="Yazar" class="form-control"
                                   placeholder="Yazarın adı" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">ISBN</label>
                            <input type="text" name="ISBN" class="form-control"
                                   placeholder="978-..." />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Fiyat (₺)</label>
                                <input type="number" name="Fiyat" class="form-control"
                                       step="0.01" min="0" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Stok Adedi</label>
                                <input type="number" name="StokAdedi" class="form-control"
                                       min="0" required />
                            </div>
                        </div>
                        <div class="mb-3">
                           <label class="form-label">Kitap Kapağı (Fotoğraf)</label>
                           <input type="file" name="FotoğrafDosyası" class="form-control"
                                  accept="image/*" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">💾 Kaydet</button>
                            <a href="/Kitap/Index" class="btn btn-secondary">İptal</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>