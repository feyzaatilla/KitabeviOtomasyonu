@model List<KitabeviApp.Models.Kitap>

@{
    ViewData["Title"] = "Kitap Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📚 Kitap Listesi</h2>
        <a href="/Kitap/Ekle" class="btn btn-success">+ Yeni Kitap Ekle</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Henüz hiç kitap eklenmemiş.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Kapak</th>
                        <th>Kitap Adı</th>
                        <th>Yazar</th>
                        <th>Fiyat</th>
                        <th>Stok</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kitap in Model)
                    {
                        <tr>
                            <td>
                                 @if (!string.IsNullOrEmpty(kitap.FotoğrafYolu))
                                {
                                     <img src="@kitap.FotoğrafYolu" style="width:50px; height:70px; object-fit:cover; border-radius:4px;" />
                                }
                                else
                                {
                                     <span class="badge bg-secondary">Yok</span>
                                 }
                            </td>
                            <td>@kitap.Adi</td>
                            <td>@kitap.Yazar</td>
                            <td>@kitap.Fiyat.ToString("C")</td>
                            <td>
                                @if (kitap.StokAdedi < 5)
                                {
                                    <span class="badge bg-danger">@kitap.StokAdedi</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@kitap.StokAdedi</span>
                                }
                            </td>
                            <td>
                                <a href="/Kitap/Duzenle/@kitap.Id" class="btn btn-sm btn-warning">✏️ Düzenle</a>
                                <a href="/Kitap/Sil/@kitap.Id" class="btn btn-sm btn-danger"
                                   onclick="return confirm('Silmek istediğinize emin misiniz?')">🗑️ Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>