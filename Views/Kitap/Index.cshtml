@model List<KitabeviApp.Models.Kitap>

@{
    ViewData["Title"] = "Kitap Listesi";
}

<div style="padding: 20px;">
    <h2>📚 Kitap Listesi</h2>
    <a href="/Kitap/Ekle" style="background:green; color:white; padding:8px 16px; 
       text-decoration:none; border-radius:4px;">+ Yeni Kitap Ekle</a>

    <br /><br />

    @if (Model.Count == 0)
    {
        <p>Henüz hiç kitap eklenmemiş.</p>
    }
    else
    {
        <table border="1" cellpadding="8" style="width:100%; border-collapse:collapse;">
            <tr style="background:#333; color:white;">
                <th>Kitap Adı</th>
                <th>Yazar</th>
                <th>Fiyat</th>
                <th>Stok</th>
                <th>İşlemler</th>
            </tr>
            @foreach (var kitap in Model)
            {
                <tr>
                    <td>@kitap.Adi</td>
                    <td>@kitap.Yazar</td>
                    <td>@kitap.Fiyat ₺</td>
                    <td style="color: @(kitap.StokAdedi < 5 ? "red" : "black")">
                        @kitap.StokAdedi
                    </td>
                    <td>
                        <a href="/Kitap/Duzenle/@kitap.Id" 
                           style="color:orange; margin-right:10px;">Düzenle</a>
                        <a href="/Kitap/Sil/@kitap.Id" 
                           onclick="return confirm('Silmek istediğinize emin misiniz?')"
                           style="color:red;">Sil</a>
                    </td>
                </tr>
            }
        </table>
    }
</div>
