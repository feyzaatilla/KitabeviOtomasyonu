@model KitabeviApp.Models.Kitap

@{
    ViewData["Title"] = "Kitap Düzenle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning">
                    <h4>✏️ Kitap Düzenle</h4>
                </div>
                <div class="card-body">
                    <form method="post" action="/Kitap/Duzenle">

                        <input type="hidden" name="Id" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label">Kitap Adı</label>
                            <input type="text" name="Adi" value="@Model.Adi"
                                   class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Yazar</label>
                            <input type="text" name="Yazar" value="@Model.Yazar"
                                   class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">ISBN</label>
                            <input type="text" name="ISBN" value="@Model.ISBN"
                                   class="form-control" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Fiyat (₺)</label>
                                <input type="number" name="Fiyat" value="@Model.Fiyat"
                                       class="form-control" step="0.01" min="0" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Stok Adedi</label>
                                <input type="number" name="StokAdedi" value="@Model.StokAdedi"
                                       class="form-control" min="0" required />
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">💾 Güncelle</button>
                            <a href="/Kitap/Index" class="btn btn-secondary">İptal</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>