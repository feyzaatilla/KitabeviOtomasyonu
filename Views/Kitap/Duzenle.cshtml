Şimdi Duzenle.cshtml dosyasına şunu yapıştır:
html@model KitabeviApp.Models.Kitap

@{
    ViewData["Title"] = "Kitap Düzenle";
}

<div style="padding: 20px; max-width: 500px;">
    <h2>✏️ Kitap Düzenle</h2>
    <hr />

    <form method="post" action="/Kitap/Duzenle">

        <input type="hidden" name="Id" value="@Model.Id" />

        <div style="margin-bottom: 15px;">
            <label>Kitap Adı:</label><br />
            <input type="text" name="Adi" value="@Model.Adi" 
                   style="width:100%; padding:8px;" required />
        </div>

        <div style="margin-bottom: 15px;">
            <label>Yazar:</label><br />
            <input type="text" name="Yazar" value="@Model.Yazar" 
                   style="width:100%; padding:8px;" required />
        </div>

        <div style="margin-bottom: 15px;">
            <label>ISBN:</label><br />
            <input type="text" name="ISBN" value="@Model.ISBN" 
                   style="width:100%; padding:8px;" />
        </div>

        <div style="margin-bottom: 15px;">
            <label>Fiyat (₺):</label><br />
            <input type="number" name="Fiyat" value="@Model.Fiyat" 
                   style="width:100%; padding:8px;" step="0.01" min="0" required />
        </div>

        <div style="margin-bottom: 15px;">
            <label>Stok Adedi:</label><br />
            <input type="number" name="StokAdedi" value="@Model.StokAdedi" 
                   style="width:100%; padding:8px;" min="0" required />
        </div>

        <button type="submit" style="background:orange; color:white; 
                padding:10px 20px; border:none; border-radius:4px; cursor:pointer;">
            💾 Güncelle
        </button>

        <a href="/Kitap/Index" style="margin-left:10px; color:gray;">İptal</a>

    </form>
</div>