@model List<KitabeviApp.Models.Musteri>

@{
    ViewData["Title"] = "Müşteri Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>👤 Müşteri Listesi</h2>
        <a href="/Musteri/Ekle" class="btn btn-success">+ Yeni Müşteri Ekle</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Henüz hiç müşteri eklenmemiş.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Ad</th>
                        <th>Soyad</th>
                        <th>Telefon</th>
                        <th>Email</th>
                        <th>Kayıt Tarihi</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var musteri in Model)
                    {
                        <tr>
                            <td>@musteri.Ad</td>
                            <td>@musteri.Soyad</td>
                            <td>@musteri.Telefon</td>
                            <td>@musteri.Email</td>
                            <td>@musteri.KayitTarihi.ToShortDateString()</td>
                            <td>
                                <a href="/Musteri/Duzenle/@musteri.Id" class="btn btn-sm btn-warning">✏️ Düzenle</a>
                                <a href="/Musteri/Sil/@musteri.Id" class="btn btn-sm btn-danger"
                                   onclick="return confirm('Silmek istediğinize emin misiniz?')">🗑️ Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>