@model KitabeviApp.Models.Musteri

@{
    ViewData["Title"] = "Yeni Müşteri Ekle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4>👤 Yeni Müşteri Ekle</h4>
                </div>
                <div class="card-body">
                    <form method="post" action="/Musteri/Ekle">

                        <div class="mb-3">
                            <label class="form-label">Ad</label>
                            <input type="text" name="Ad" class="form-control"
                                   placeholder="Müşteri adı" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Soyad</label>
                            <input type="text" name="Soyad" class="form-control"
                                   placeholder="Müşteri soyadı" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Telefon</label>
                            <input type="text" name="Telefon" class="form-control"
                                   placeholder="05xx xxx xx xx" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" name="Email" class="form-control"
                                   placeholder="ornek@email.com" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">💾 Kaydet</button>
                            <a href="/Musteri/Index" class="btn btn-secondary">İptal</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>