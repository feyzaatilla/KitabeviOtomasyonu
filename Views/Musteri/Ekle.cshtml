@model KitabeviApp.Models.Musteri

@{
    ViewData["Title"] = "Yeni Müşteri Ekle";
}

<div style="padding: 20px; max-width: 500px;">
    <h2>👤 Yeni Müşteri Ekle</h2>
    <hr />

    <form method="post" action="/Musteri/Ekle">

        <div style="margin-bottom: 15px;">
            <label>Ad:</label><br />
            <input type="text" name="Ad" style="width:100%; padding:8px;" 
                   placeholder="Müşteri adı" required />
        </div>

        <div style="margin-bottom: 15px;">
            <label>Soyad:</label><br />
            <input type="text" name="Soyad" style="width:100%; padding:8px;" 
                   placeholder="Müşteri soyadı" required />
        </div>

        <div style="margin-bottom: 15px;">
            <label>Telefon:</label><br />
            <input type="text" name="Telefon" style="width:100%; padding:8px;" 
                   placeholder="05xx xxx xx xx" />
        </div>

        <div style="margin-bottom: 15px;">
            <label>Email:</label><br />
            <input type="email" name="Email" style="width:100%; padding:8px;" 
                   placeholder="ornek@email.com" />
        </div>

        <button type="submit" style="background:green; color:white; 
                padding:10px 20px; border:none; border-radius:4px; cursor:pointer;">
            💾 Kaydet
        </button>

        <a href="/Musteri/Index" style="margin-left:10px; color:gray;">İptal</a>

    </form>
</div>
