@model KitabeviApp.Models.Musteri

@{
    ViewData["Title"] = "Müşteri Düzenle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning">
                    <h4>✏️ Müşteri Düzenle</h4>
                </div>
                <div class="card-body">
                    <form method="post" action="/Musteri/Duzenle">

                        <input type="hidden" name="Id" value="@Model.Id" />
                        <input type="hidden" name="KayitTarihi" value="@Model.KayitTarihi" />

                        <div class="mb-3">
                            <label class="form-label">Ad</label>
                            <input type="text" name="Ad" value="@Model.Ad"
                                   class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Soyad</label>
                            <input type="text" name="Soyad" value="@Model.Soyad"
                                   class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Telefon</label>
                            <input type="text" name="Telefon" value="@Model.Telefon"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" name="Email" value="@Model.Email"
                                   class="form-control" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">💾 Güncelle</button>
                            <a href="/Musteri/Index" class="btn btn-secondary">İptal</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>