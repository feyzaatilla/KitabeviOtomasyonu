@{
    ViewData["Title"] = "Yeni Satış";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4>🛒 Yeni Satış Ekle</h4>
                </div>
                <div class="card-body">

                    @if (TempData["Hata"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Hata"]</div>
                    }

                    <form method="post" action="/Satis/Ekle">

                        <div class="mb-3">
                            <label class="form-label">Müşteri</label>
                            <select name="MusteriId" class="form-select" required>
                                <option value="">-- Müşteri Seçin --</option>
                                @foreach (var musteri in ViewBag.Musteriler)
                                {
                                    <option value="@musteri.Id">@musteri.Ad @musteri.Soyad</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Kitap</label>
                            <select name="KitapId" class="form-select" required>
                                <option value="">-- Kitap Seçin --</option>
                                @foreach (var kitap in ViewBag.Kitaplar)
                                {
                                    <option value="@kitap.Id">
                                        @kitap.Adi — @kitap.Fiyat ₺ (Stok: @kitap.StokAdedi)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Adet</label>
                            <input type="number" name="Adet" class="form-control"
                                   min="1" value="1" required />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">💾 Satışı Kaydet</button>
                            <a href="/Satis/Index" class="btn btn-secondary">İptal</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>