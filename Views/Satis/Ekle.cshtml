@{
    ViewData["Title"] = "Yeni Satış";
}

<div style="padding: 20px; max-width: 500px;">
    <h2>🛒 Yeni Satış Ekle</h2>
    <hr />

    @if (TempData["Hata"] != null)
    {
        <div style="background:red; color:white; padding:10px; margin-bottom:15px; border-radius:4px;">
            @TempData["Hata"]
        </div>
    }

    <form method="post" action="/Satis/Ekle">

        <div style="margin-bottom: 15px;">
            <label>Müşteri:</label><br />
            <select name="MusteriId" style="width:100%; padding:8px;" required>
                <option value="">-- Müşteri Seçin --</option>
                @foreach (var musteri in ViewBag.Musteriler)
                {
                    <option value="@musteri.Id">@musteri.Ad @musteri.Soyad</option>
                }
            </select>
        </div>

        <div style="margin-bottom: 15px;">
            <label>Kitap:</label><br />
            <select name="KitapId" style="width:100%; padding:8px;" required>
                <option value="">-- Kitap Seçin --</option>
                @foreach (var kitap in ViewBag.Kitaplar)
                {
                    <option value="@kitap.Id">@kitap.Adi - @kitap.Fiyat ₺ (Stok: @kitap.StokAdedi)</option>
                }
            </select>
        </div>

        <div style="margin-bottom: 15px;">
            <label>Adet:</label><br />
            <input type="number" name="Adet" style="width:100%; padding:8px;" 
                   min="1" value="1" required />
        </div>

        <button type="submit" style="background:green; color:white; 
                padding:10px 20px; border:none; border-radius:4px; cursor:pointer;">
            💾 Satışı Kaydet
        </button>

        <a href="/Satis/Index" style="margin-left:10px; color:gray;">İptal</a>

    </form>
</div>
