@model List<KitabeviApp.Models.Satis>

@{
    ViewData["Title"] = "Satış Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🛒 Satış Listesi</h2>
        <a href="/Satis/Ekle" class="btn btn-success">+ Yeni Satış Ekle</a>
    </div>

    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger">@TempData["Hata"]</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Henüz hiç satış yapılmamış.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Satış No</th>
                        <th>Müşteri</th>
                        <th>Kitaplar</th>
                        <th>Toplam</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var satis in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">#@satis.Id</span></td>
                            <td>@satis.Musteri?.Ad @satis.Musteri?.Soyad</td>
                            <td>
                                @foreach (var detay in satis.SatisDetaylari)
                                {
                                    <span class="badge bg-info text-dark me-1">
                                        @detay.Kitap?.Adi (@detay.Adet adet)
                                    </span>
                                }
                            </td>
                            <td><strong>@satis.ToplamTutar.ToString("C")</strong></td>
                            <td>@satis.SatisTarihi.ToShortDateString()</td>
                            <td><span class="badge bg-success">@satis.OdemeDurumu</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
