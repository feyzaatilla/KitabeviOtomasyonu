@model List<KitabeviApp.Models.Satis>

@{
    ViewData["Title"] = "Satış Listesi";
}

<div style="padding: 20px;">
    <h2>🛒 Satış Listesi</h2>
    <a href="/Satis/Ekle" style="background:green; color:white; padding:8px 16px; 
       text-decoration:none; border-radius:4px;">+ Yeni Satış Ekle</a>

    <br /><br />

    @if (TempData["Hata"] != null)
    {
        <div style="background:red; color:white; padding:10px; margin-bottom:15px; border-radius:4px;">
            @TempData["Hata"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <p>Henüz hiç satış yapılmamış.</p>
    }
    else
    {
        <table border="1" cellpadding="8" style="width:100%; border-collapse:collapse;">
            <tr style="background:#333; color:white;">
                <th>Satış No</th>
                <th>Müşteri</th>
                <th>Kitaplar</th>
                <th>Toplam</th>
                <th>Tarih</th>
                <th>Durum</th>
            </tr>
            @foreach (var satis in Model)
            {
                <tr>
                    <td>#@satis.Id</td>
                    <td>@satis.Musteri?.Ad @satis.Musteri?.Soyad</td>
                    <td>
                        @foreach (var detay in satis.SatisDetaylari)
                        {
                            <span>@detay.Kitap?.Adi (@detay.Adet adet)</span><br />
                        }
                    </td>
                    <td>@satis.ToplamTutar.ToString("C")</td>
                    <td>@satis.SatisTarihi.ToShortDateString()</td>
                    <td style="color:green;">@satis.OdemeDurumu</td>
                </tr>
            }
        </table>
    }
</div>
